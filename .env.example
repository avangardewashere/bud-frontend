# All three are read at BUILD time: NEXT_PUBLIC_ values are inlined into the client
# bundle, and BUD_API_ORIGIN is compiled into the /api rewrite. Change one, rebuild.
# A production build refuses to start if any is blank or is not a bare origin.

# The shell's own origin. bridge.js is served from here and course frames post to it.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3100

# The courses origin. MUST be a different origin from the app — that separation,
# not the sandbox attribute, is what stops course JavaScript reading the session.
# It differs by host and not just port, because cookies ignore ports.
NEXT_PUBLIC_COURSES_ORIGIN=http://127.0.0.1:3101

# Where the Bud API really is ("Bud - backend", npm run start:dev). Server-only.
# The browser never calls it directly: it calls /api on the app's own origin and the
# shell forwards the request here, so the session cookie is first-party on the app.
# Server components call it directly, forwarding the learner's cookie.
BUD_API_ORIGIN=http://localhost:3102
