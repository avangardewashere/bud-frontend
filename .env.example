# The shell's own origin. bridge.js is served from here and course frames post to it.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3100

# The courses origin. MUST be a different origin from the app — that separation,
# not the sandbox attribute, is what stops course JavaScript reading the session.
# 3101 rather than 3001 because 3001 is commonly already in use.
NEXT_PUBLIC_COURSES_ORIGIN=http://127.0.0.1:3101

# Where the typed client points. In v0 this is the in-app stub; swapping to the
# real backend is changing this one line and deleting src/app/api + src/stub.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3100/api

# Stub-only. Where the JSON-file mirror of the in-memory store lives.
BUD_STUB_DATA_DIR=.bud-dev
