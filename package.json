{
  "name": "budlearn-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,courses -c green,cyan \"next dev -p 3100\" \"node tools/courses-server.mjs\"",
    "dev:web": "next dev -p 3100",
    "courses": "node tools/courses-server.mjs",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
